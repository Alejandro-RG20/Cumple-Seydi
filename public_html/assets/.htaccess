# Archivos estáticos: nunca ejecutar scripts aquí (por si alguien sube un archivo).
# Nota: sin directivas "Options" (InfinityFree no las permite en subcarpetas y daría error 500).
<FilesMatch "(?i)\.(php\d?|phtml|phar|pl|py|cgi|sh|asp|aspx|jsp|shtml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
